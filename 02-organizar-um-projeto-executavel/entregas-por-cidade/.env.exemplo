# Copie este arquivo para .env e ajuste para a sua máquina.
# O .env fica fora do Git (veja o .gitignore). Este exemplo vai para o Git, sem segredo nenhum.
# Caminho relativo parte da pasta do projeto.
LOJA_DADOS=../../dados/loja
LOJA_SAIDA=saida
# Token da API local, usado a partir da aula «Consumir uma API paginada». Deixe vazio por enquanto.
LOJA_TOKEN_API=
